	column genre_count
		dataType: int64
		lineageTag: 2ca9e519-d0c6-5c4f-9b92-060bbae3b51d
		summarizeBy: none
		sourceColumn: genre_count

	column 'Runtime Band Order' =
			IF (
			    titles[type] = "Movie",
			    SWITCH (
			        TRUE (),
			        titles[duration_value] < 60, 1,
			        titles[duration_value] <= 90, 2,
			        titles[duration_value] <= 120, 3,
			        titles[duration_value] <= 150, 4,
			        5
			    )
			)
		dataType: int64
		lineageTag: 8a85e265-30c1-5428-9913-c84073b303cb
		summarizeBy: none
		isHidden

	column 'Runtime Band' =
			IF (
			    titles[type] = "Movie",
			    SWITCH (
			        TRUE (),
			        titles[duration_value] < 60, "<60",
			        titles[duration_value] <= 90, "60-90",
			        titles[duration_value] <= 120, "91-120",
			        titles[duration_value] <= 150, "121-150",
			        "150+"
			    )
			)
		dataType: string
		lineageTag: e9c34dd4-be3d-54dd-9649-05f3db219175
		summarizeBy: none
		sortByColumn: 'Runtime Band Order'

	column 'Season Bucket' =
			IF (
			    titles[type] = "TV Show",
			    IF ( titles[duration_value] >= 6, "6+", FORMAT ( titles[duration_value], "0" ) )
			)
		dataType: string
		lineageTag: a17e4716-e563-500c-8dbf-b7a8d0be81ee
		summarizeBy: none

	column 'Release Decade' =
			FLOOR ( titles[release_year], 10 ) & "s"
		dataType: string
		lineageTag: 5ec8126a-cfc3-5b96-8e7b-631f4b3ccfae
		summarizeBy: none

	partition titles = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "netflix_titles_clean.csv"), [Delimiter = ",", Columns = 22, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    RemovedUnusedColumns = Table.RemoveColumns(PromotedHeaders, {"cast", "description"}),
				    BlanksToNull = Table.ReplaceValue(RemovedUnusedColumns, "", null, Replacer.ReplaceValue, {"date_added", "added_year", "added_month", "added_month_name", "content_age_at_add"}),
				    ChangedTypes = Table.TransformColumnTypes(BlanksToNull, {{"show_id", type text}, {"type", type text}, {"title", type text}, {"director", type text}, {"country", type text}, {"primary_country", type text}, {"country_count", Int64.Type}, {"date_added", type date}, {"added_year", Int64.Type}, {"added_month", Int64.Type}, {"added_month_name", type text}, {"release_year", Int64.Type}, {"content_age_at_add", Int64.Type}, {"rating", type text}, {"audience_group", type text}, {"duration", type text}, {"duration_value", Int64.Type}, {"duration_unit", type text}, {"listed_in", type text}, {"genre_count", Int64.Type}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_ResultType = Table
