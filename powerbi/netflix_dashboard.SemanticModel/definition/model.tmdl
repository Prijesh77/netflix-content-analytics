model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "titles", "title_countries", "title_genres", "Dim Country", "Dim Genre", "Dim Date", "_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table titles
ref table title_countries
ref table title_genres
ref table 'Dim Country'
ref table 'Dim Genre'
ref table 'Dim Date'
ref table _Measures

ref cultureInfo en-US

