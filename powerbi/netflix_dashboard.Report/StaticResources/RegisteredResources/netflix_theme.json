{
  "name": "Netflix Content Analytics (Dark)",
  "dataColors": [
    "#E50914",
    "#8FB8DE",
    "#B3B3B3",
    "#F5C518",
    "#6FCF97",
    "#BB86FC",
    "#F2994A",
    "#56CCF2"
  ],
  "background": "#141414",
  "foreground": "#E5E5E5",
  "tableAccent": "#E50914",
  "good": "#6FCF97",
  "neutral": "#B3B3B3",
  "bad": "#E50914",
  "maximum": "#E50914",
  "center": "#5A5A5A",
  "minimum": "#2B2B2B",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#E5E5E5"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#B3B3B3"
    },
    "largeTitle": {
      "fontSize": 20,
      "fontFace": "Segoe UI Bold",
      "color": "#FFFFFF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2E2E2E"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "foreground": {
              "solid": {
                "color": "#B3B3B3"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#2E2E2E"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "position": "Top"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E5E5E5"
              }
            }
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#141414"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "background": {
              "solid": {
                "color": "#1F1F1F"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2B2B2B"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#242424"
              }
            }
          }
        ]
      }
    }
  }
}